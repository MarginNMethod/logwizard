{
  "persona_id": "career-center",
  "produced_by": "Claude Code subagent run of evals/planner-prompt.md (no paid API call)",
  "date": "2026-10-11",
  "planner_prompt_version": "v1",
  "raw_plan": {
    "plan": {
      "schema_version": 1,
      "system_name": "Employer Outreach Log",
      "time_zone": "America/Chicago",
      "owner": {
        "name": "Sample Owner",
        "email": "owner@example.com"
      },
      "contributors": [
        {
          "name": "Sample Rep",
          "email": "rep@example.com",
          "role": "contributor"
        }
      ],
      "logs": [
        {
          "id": "main",
          "name": "Employer Outreach Log",
          "fields": [
            {
              "key": "organization_name",
              "label": "Organization name",
              "type": "text",
              "required": true
            },
            {
              "key": "contact_email",
              "label": "Contact email",
              "type": "email",
              "required": false
            },
            {
              "key": "interaction_type",
              "label": "Interaction type",
              "type": "choice",
              "required": false,
              "options": [
                "email",
                "call",
                "meeting",
                "event"
              ]
            },
            {
              "key": "date",
              "label": "Date",
              "type": "date",
              "required": true
            },
            {
              "key": "area",
              "label": "Area",
              "type": "multi_choice",
              "required": false,
              "options": [
                "Education",
                "Psychology",
                "Arts"
              ]
            },
            {
              "key": "follow_up_date",
              "label": "Follow-up date",
              "type": "date",
              "required": false
            },
            {
              "key": "notes",
              "label": "Notes",
              "type": "long_text",
              "required": false
            }
          ]
        },
        {
          "id": "education",
          "name": "Education Log",
          "copy_fields_from": "main"
        },
        {
          "id": "psychology",
          "name": "Psychology Log",
          "copy_fields_from": "main"
        },
        {
          "id": "arts",
          "name": "Arts Log",
          "copy_fields_from": "main"
        }
      ],
      "routing_rules": [
        {
          "from": "main",
          "when": {
            "field": "area",
            "includes": "Education"
          },
          "copy_to": "education"
        },
        {
          "from": "main",
          "when": {
            "field": "area",
            "includes": "Psychology"
          },
          "copy_to": "psychology"
        },
        {
          "from": "main",
          "when": {
            "field": "area",
            "includes": "Arts"
          },
          "copy_to": "arts"
        }
      ],
      "reminders": [
        {
          "type": "follow_up_due",
          "log": "main",
          "date_field": "follow_up_date",
          "days_before": 1,
          "notify": [
            "owner"
          ],
          "send_hour": 8
        },
        {
          "type": "weekly_digest",
          "day": "MON",
          "send_hour": 8,
          "notify": [
            "owner"
          ]
        }
      ],
      "alerts": [
        {
          "on": "new_entry",
          "when_entered_by": "contributor",
          "notify": [
            "owner"
          ]
        }
      ]
    },
    "follow_up_questions": [],
    "unsupported_requests": []
  },
  "validation": {
    "first_try_pass": true,
    "retried": false,
    "retry_pass": null
  },
  "notes": "Planned inline by the recording worker itself (single context) from planner-prompt v1 and the persona answers only, not by a separate fresh subagent; model Claude Sonnet 5.5."
}
