# All variables are optional. The app builds, tests, and runs in replay mode with none of them set.
# Placeholders only. Never commit real values. Put real values in .env.local (git-ignored).

# Model used for bring-your-own-key calls.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Anonymous metrics (Supabase Free plan). Leave unset to skip metrics and use in-memory rate limiting.
SUPABASE_URL=https://your-project.supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Secret salt for hashing visitor IPs for rate limiting. Any long random string.
RATE_LIMIT_SALT=replace-me

# Live mode is OFF and not part of the plan. Leave this unset (see README).
# AI_MODE=live
