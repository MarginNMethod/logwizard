# Copy to .env.local and fill in. Never commit .env.local.
# No paid key is needed. Replay mode is the default and costs nothing.
# Leave ANTHROPIC_API_KEY unset. Visitors may paste their own key in the browser.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MODE=replay

# Future (Phase 4, Google build step, not built yet). Nothing reads these today.
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_TEMPLATE_FILE_ID=your-template-file-id

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only
